NODE_ENV=development
PORT=3000

# Konfigurasi Database MySQL
# Development lokal (XAMPP): DB_SSL=false dan DB_SSL_CA_BASE64 dikosongkan.
# Production (Aiven MySQL / Vercel): set DB_SSL=true dan isi DB_SSL_CA_BASE64
# dengan string Base64 dari file Aiven CA Certificate (ca.pem).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mynotes_db
DB_SSL=false
DB_SSL_CA_BASE64=

JWT_SECRET=
JWT_EXPIRES_IN=1d

BCRYPT_SALT_ROUNDS=12

CORS_ORIGIN=*

